## EXPIRES CACHING ##
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access 7 days"
ExpiresByType image/jpeg "access 7 days"
ExpiresByType image/gif "access 7 days"
ExpiresByType image/png "access 7 days"
ExpiresByType image/webp "access 7 days"
ExpiresByType image/svg+xml "access 7 days"
ExpiresByType image/x-icon "access 7 days"
ExpiresByType text/css "access 7 days"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/pdf "access 7 days"
ExpiresByType text/javascript "access 7 days"
ExpiresByType application/javascript "access 7 days"
ExpiresByType application/x-javascript "access 7 days"
ExpiresByType font/woff2 "access 1 year"
ExpiresByType font/woff "access 1 year"
ExpiresByType video/mp4 "access 7 days"
ExpiresByType video/webm "access 7 days"
ExpiresByType application/font-woff2 "access 1 year"
ExpiresByType application/manifest+json "access 7 days"
ExpiresByType application/xml "access 1 day"
ExpiresDefault "access 1 day"
</IfModule>
## EXPIRES CACHING ##

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/svg+xml svg svgz
AddType font/woff2 .woff2
AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
<IfModule mod_filter.c>
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/x-javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE application/manifest+json
AddOutputFilterByType DEFLATE image/svg+xml
AddOutputFilterByType DEFLATE font/woff2
</IfModule>
</IfModule>

<ifModule mod_gzip.c>
mod_gzip_on Yes
mod_gzip_dechunk Yes
mod_gzip_item_include file .(html?|txt|css|js|php|pl|svg|webmanifest)$
mod_gzip_item_include handler ^cgi-script$
mod_gzip_item_include mime ^text/.*
mod_gzip_item_include mime ^application/x-javascript.*
mod_gzip_item_include mime ^application/javascript.*
mod_gzip_item_include mime ^application/json.*
mod_gzip_item_include mime ^image/svg+xml.*
mod_gzip_item_exclude mime ^image/.*
mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>

# Hide server details from response headers and error pages
ServerSignature Off

<IfModule mod_headers.c>
  # "always" adds the header to redirects and error pages too
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Clickjacking: only this site may show these pages in a frame (homepage popups use same-origin frames)
  Header always set X-Frame-Options "SAMEORIGIN"

  # HTTPS only for a year. No includeSubDomains until every subdomain is confirmed on HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Content Security Policy for the site pages. /demo/ has its own, looser policy (demo/.htaccess).
  # Allowed outside origins: Google tag (analytics), the Supabase functions behind the AI assistant
  # and the Message me form, YouTube embeds. Inline scripts and styles are still allowed because the
  # builders write small inline scripts and style attributes; moving them out would allow a stricter policy.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://bmtnfhppzrkztmqzwrhx.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.googletagmanager.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # No access to camera, microphone or location from the site pages
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HTML: always revalidate so visitors see new pages right after a deploy
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Footer for outside apps: loaded from a fixed address (no version number),
  # so a short cache lets a change reach every app within an hour
  <FilesMatch "^sv-footer\.js$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Fonts: long-lived (1 year). Filenames are stable, but font files change rarely.
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Images and media: not content-hashed (og-image.jpg, demo posters, mp4/webm
  # change in place), so 7 days, no immutable
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # CSS/JS: not content-hashed (theme.css etc. change in place), so 7 days, no immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Plain http:// always moves to https:// on the apex domain, in one step.
  # The X-Forwarded-Proto check stops a loop if a proxy in front already speaks HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://sarunasvaitkus.com%{REQUEST_URI} [L,R=301]

  # Canonical host: www → apex
  RewriteCond %{HTTP_HOST} ^www\.sarunasvaitkus\.com$ [NC]
  RewriteRule ^ https://sarunasvaitkus.com%{REQUEST_URI} [L,R=301]

  # Canonical URL: /index.html → /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Legacy duplicate HTML that must not compete with the homepage
  RewriteRule ^(index-backup|index-pre-design-mirror|index3js|_darkTheme|_portfolio-alter)\.html$ / [L,R=301]
</IfModule>

ErrorDocument 404 /404.html
